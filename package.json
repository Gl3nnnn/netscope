{
  "name": "netscope",
  "private": true,
  "version": "1.0.0",
  "description": "NetScope - a static, DEMO-data network monitoring dashboard built with React, TypeScript, D3 and Recharts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-progress": "1.1.17",
    "@radix-ui/react-scroll-area": "1.3.0",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-separator": "1.1.16",
    "@radix-ui/react-slider": "1.5.0",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3": "7.4.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
